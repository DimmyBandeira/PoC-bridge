{
  "poc_provider": {
    "type": "poc",
    "enabled": false,
    "appKey": "${ICONVNET_APP_KEY}",
    "appSecret": "${ICONVNET_APP_SECRET}",
    "dispatch_endpoint": "${ICONVNET_DISPATCH_ENDPOINT}",
    "cancel_endpoint": "${ICONVNET_CANCEL_ENDPOINT}",
    "upload_endpoint": "${ICONVNET_UPLOAD_ENDPOINT}",
    "timezone": "America/Sao_Paulo"
  },
  "whatsapp_mock": {
    "type": "whatsapp",
    "enabled": true
  },
  "teams_mock": {
    "type": "teams",
    "enabled": true
  }
}
